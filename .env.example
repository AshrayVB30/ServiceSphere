# ==============================================================================
# ServiceSphere - Docker Deployment Environment Configuration
# Copy this file to .env and adjust credentials before production deployment.
# ==============================================================================

# --- Django Core Configuration ---
DJANGO_SECRET_KEY=servicesphere-production-secret-key-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx,frontend

# --- PostgreSQL Container Credentials ---
DB_NAME=servicesphere_db
DB_USER=postgres
DB_PASSWORD=servicesphere_password
DB_HOST=db
DB_PORT=5432

# --- Redis & Celery ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Security / CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# --- Email Notifications (Optional SMTP) ---
EMAIL_NOTIFICATIONS_ENABLED=False
DEFAULT_FROM_EMAIL=support@servicesphere.local

