# ==============================================================================
# ServiceSphere Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' in the same folder and fill in your actual values.
# NEVER commit the real '.env' file containing secrets to version control.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Generate a secret random string for cryptographic signing
DJANGO_SECRET_KEY=your-secret-key-here

# Enable detailed debug messages (Set to False in production environments)
DJANGO_DEBUG=True

# Comma-separated list of domain names or IP addresses that this server will answer
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- POSTGRESQL DATABASE CREDENTIALS ---
# Name of the relational database for ServiceSphere
DB_NAME=servicesphere_db

# PostgreSQL database superuser or dedicated role
DB_USER=postgres

# Password associated with the DB_USER above
DB_PASSWORD=your_postgres_password

# Database server host address (127.0.0.1 for local host)
DB_HOST=127.0.0.1

# Database port (typically 5432, or 5433 if running alongside another instance)
DB_PORT=5433
