# ==============================================================================
# ServiceSphere Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' and fill in your actual production values.
# NEVER commit the real '.env' file containing secrets to version control.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Generate a secret random string for cryptographic signing (mandatory in production)
DJANGO_SECRET_KEY=your-secret-key-here

# Enable detailed debug messages (MUST BE False IN PRODUCTION)
DJANGO_DEBUG=False

# Comma-separated list of domain names or IP addresses that this server will answer
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Comma-separated list of origins trusted for CSRF validation (Django 4.0+)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Comma-separated list of origins allowed to make Cross-Origin requests (Frontend React)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# --- HTTPS & COOKIE SECURITY (Set to True in Production) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- POSTGRESQL DATABASE CREDENTIALS ---
DB_NAME=servicesphere_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSLMODE=prefer

# --- CELERY & REDIS MESSAGE BROKER ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- EMAIL NOTIFICATIONS (SMTP) ---
EMAIL_NOTIFICATIONS_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=support@servicesphere.local
